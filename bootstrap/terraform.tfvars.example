# ── HCP Terraform workspace identity ────────────────────────────────────────
hcp_terraform_organization = "replace-with-your-org"
hcp_terraform_workspace    = "vault-ec2"

# ── Workspace tagging ────────────────────────────────────────────────────────
project_name        = "vault-ec2"
application         = "vault"
owner               = "team-devops"
support_team        = "sre-team"
cost_center         = "cc-104"
data_classification = "confidential"
compliance          = ["none"]
environment         = "dev"

# ── Root module variables written to the workspace ───────────────────────────
allowed_cidr_blocks    = ["203.0.113.10/32"]
ami_owner_account_id   = "123456789012"
aws_region             = "us-east-1"
existing_key_pair_name = "your-existing-keypair"
instance_type          = "t3.small"
route53_zone_name      = "example.com"
ssh_private_key_path   = "linux.pem"
vault_domain           = "vault.example.com"
vault_edition          = "enterprise"
# vault_enterprise_license = "set-this-to-your-license-string"
